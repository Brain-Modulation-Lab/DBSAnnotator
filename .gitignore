# Repo-root ignores for the Flutter app, which lives here.
#
# Be careful adding anything that could match `lib/`: the Dart source is at
# lib/, and an ignore rule covering it fails silently — already-tracked files
# stay tracked, and only NEW files vanish from `git status`.
# `git check-ignore -v lib/main.dart` must print nothing.

# ---- Flutter / Dart ----
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# pubspec.lock IS committed: this is an application, so builds must be
# reproducible.

# Local report/preview artifacts from throwaway rasterisation tests.
preview/

# ---- Signing secrets — NEVER commit (see MOBILE_RELEASE.md) ----
android/key.properties
*.jks
*.keystore
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/*.mobileprovision
**/*.p8
# Windows code-signing. `dart run msix:create` generates a self-signed test
# certificate next to the project when none is configured; it is a private key
# like any other. No CA certificate is ever needed here — the Microsoft Store
# re-signs MSIX packages itself.
*.pfx
*.cer
*.p12

# ---- Docs (Sphinx, built by Read the Docs from docs/) ----
# Byte-compiled output of docs/_ext/. A .pyc was tracked before this rule.
__pycache__/
*.py[cod]
docs/_build/

# ---- Editors / OS ----
*.iml
.idea/
.DS_Store
Thumbs.db

# ---- Stale local scratch ----
archive/
test_save_probe.png

# Sphinx build output: docs/_generated/ is rendered from schema/tsv_schema.json
# by docs/_ext/generated_includes.py on every build, so it is never committed.
docs/_generated/
