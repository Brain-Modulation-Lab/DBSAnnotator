# Ignores for the frozen Qt/Python app.
#
# These rules used to live in the repo-root .gitignore, when the Python project
# owned the root. They are anchored to this directory now, which is also what
# makes them safe: `lib/` and `lib64/` below are Python virtualenv artifacts,
# and at the repo root they would match the Flutter app's Dart source tree.

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Packaging / Briefcase ----
build/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ---- Test / coverage ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ---- Type checkers / linters ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ---- Environments ----
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---- Sphinx ----
# conf.py relies on _autosummary being ignored HERE rather than in Sphinx's
# exclude_patterns, because autosummary must be able to parse it during a build.
docs/_build/
docs/_autosummary/

# ---- Editors / misc ----
.spyderproject
.spyproject
.ropeproject
.ipynb_checkpoints
profile_default/
ipython_config.py
.pypirc
